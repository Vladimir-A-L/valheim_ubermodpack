<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>DungeonDepthPrototype</AssemblyName>
    <Version>0.5.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../.local/server-gameplay</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../dungeon-geometry-probe/RoomGraph.cs" Link="RoomGraph.cs" />
    <Reference Include="EpicLoot"
               HintPath="$(GameDir)/BepInEx/plugins/RandyKnapp-EpicLoot/EpicLoot.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim"
               HintPath="$(GameDir)/valheim_server_Data/Managed/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils"
               HintPath="$(GameDir)/valheim_server_Data/Managed/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule"
               HintPath="$(GameDir)/valheim_server_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine"
               HintPath="$(GameDir)/valheim_server_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule"
               HintPath="$(GameDir)/valheim_server_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="SoftReferenceableAssets"
               HintPath="$(GameDir)/valheim_server_Data/Managed/SoftReferenceableAssets.dll" Private="false" />
    <Reference Include="Newtonsoft.Json"
               HintPath="$(GameDir)/BepInEx/plugins/ValheimModding-JsonDotNET/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>
