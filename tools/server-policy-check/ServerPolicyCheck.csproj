<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../.local/server-gameplay</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ServerManager"
               HintPath="$(GameDir)/BepInEx/plugins/ServerManager/ServerManager.dll" />
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(GameDir)/BepInEx/core/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
